{
  "name": "helium-services-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    "PROXY_BASE_URL": "https://helium-services-worker.yingo.workers.dev/ext",
    "UBO_PROXY_BASE_URL": "https://helium-services-worker.yingo.workers.dev/ubo",
    "CHROMIUM_FALLBACK_VERSION": "151.0.7922.71"
  }
}
